.page {
  min-height: 100%;
  padding: clamp(26px, 4vw, 46px);
  border-radius: 26px;
  background:
    radial-gradient(circle at 88% 8%, rgba(92, 145, 232, 0.13), transparent 24%),
    rgba(255, 255, 255, 0.36);
}

.hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  padding-bottom: 28px;
  border-bottom: 1px solid rgba(28, 64, 99, 0.12);
}

.eyebrow {
  margin: 0;
  color: #3c73a8;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 0.16em;
}

.hero h1 {
  margin: 8px 0 8px;
  color: #142a42;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(38px, 5vw, 62px);
  font-weight: 500;
}

.hero p:not(.eyebrow) {
  margin: 0;
  color: rgba(20, 42, 66, 0.62);
}

.editButton,
.editor button,
.controls button {
  border: 1px solid rgba(28, 64, 99, 0.14);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.58);
  color: #234c74;
  cursor: pointer;
  font: inherit;
  font-size: 11px;
  font-weight: 800;
}

.editButton {
  padding: 10px 16px;
}

.section {
  margin-top: 30px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-top: 12px;
}

.launchCard {
  overflow: hidden;
  border: 1px solid rgba(28, 64, 99, 0.11);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.58);
  box-shadow: 0 10px 28px rgba(35, 72, 108, 0.04);
}

.launchLink {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 11px;
  min-height: 74px;
  padding: 13px;
  color: #183653;
  text-decoration: none;
}

.badge {
  display: grid;
  width: 34px;
  height: 34px;
  place-items: center;
  border: 1px solid rgba(43, 92, 138, 0.13);
  border-radius: 10px;
  background: rgba(74, 129, 185, 0.08);
  font-weight: 850;
}

.launchLink strong,
.launchLink small {
  display: block;
}

.launchLink strong {
  font-size: 13px;
}

.launchLink small {
  margin-top: 3px;
  color: rgba(24, 54, 83, 0.5);
  font-size: 9px;
}

.arrow {
  color: #477cae;
}

.controls {
  display: flex;
  gap: 6px;
  padding: 0 10px 10px;
}

.controls button {
  padding: 6px 8px;
}

.controls button:last-child {
  margin-left: auto;
}

.editor {
  margin-top: 34px;
  padding: 22px;
  border: 1px solid rgba(28, 64, 99, 0.11);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.42);
}

.editor h2 {
  margin: 6px 0 16px;
  color: #183653;
  font-family: Georgia, "Times New Roman", serif;
  font-weight: 500;
}

.editor form {
  display: grid;
  grid-template-columns: 0.7fr 1.4fr auto;
  gap: 9px;
}

.editor input {
  min-width: 0;
  padding: 10px 12px;
  border: 1px solid rgba(28, 64, 99, 0.14);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.7);
  color: #183653;
  font: inherit;
}

.editor form button,
.reset {
  padding: 10px 13px;
}

.reset {
  margin-top: 10px;
}

@media (max-width: 1050px) {
  .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 640px) {
  .hero { align-items: flex-start; flex-direction: column; }
  .grid { grid-template-columns: 1fr; }
  .editor form { grid-template-columns: 1fr; }
}
