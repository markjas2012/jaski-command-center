import { NextResponse } from "next/server";

export const dynamic = "force-dynamic";

type LiveItem = {
  artist: string;
  title: string;
  venue?: string;
  location?: string;
  date?: string;
  time?: string;
  source: string;
  href: string;
  action?: "Watch" | "Listen" | "Details";
};

function strip(html: string) {
  return html
    .replace(/<script[\s\S]*?<\/script>/gi, " ")
    .replace(/<style[\s\S]*?<\/style>/gi, " ")
    .replace(/<[^>]+>/g, " ")
    .replace(/&amp;|&#038;/g, "&")
    .replace(/&#8217;|&#39;/g, "'")
    .replace(/&quot;/g, '"')
    .replace(/\s+/g, " ")
    .trim();
}

function absolute(href: string, base: string) {
  if (href.startsWith("http")) return href;
  if (href.startsWith("/")) return `${base}${href}`;
  return `${base}/${href}`;
}

async function fetchText(url: string) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 6500);
  try {
    const res = await fetch(url, {
      cache: "no-store",
      signal: controller.signal,
      headers: { "User-Agent": "Mozilla/5.0 JaskiCommandCenter/13.19" },
    });
    if (!res.ok) throw new Error(`${res.status}`);
    return await res.text();
  } finally {
    clearTimeout(timer);
  }
}

async function fromNugs(): Promise<LiveItem[]> {
  try {
    const html = await fetchText("https://www.nugs.net/watch-live-music/");
    const matches = Array.from(html.matchAll(/href=["']([^"']*(?:WEBCASTVARIANT|live-download)[^"']*\.html)["']/gi));
    const out: LiveItem[] = [];
    const seen = new Set<string>();

    for (const match of matches) {
      const href = absolute(match[1], "https://www.nugs.net");
      if (seen.has(href)) continue;
      seen.add(href);

      const index = match.index ?? 0;
      const chunk = strip(html.slice(Math.max(0, index - 1200), index + 1400));
      const dateMatch = chunk.match(/\b(\d{1,2}\/\d{1,2}\/(?:20)?\d{2})\b/);

      const titleGuess = chunk
        .split(/(?:\s{2,}| · |\|)/)
        .map((x) => x.trim())
        .find((x) => x.length > 8 && x.length < 120 && /arena|theatre|theater|amphithe|center|centre|park|hall|festival|pavilion|show|live/i.test(x));

      out.push({
        artist: "Live on Nugs",
        title: titleGuess || "Upcoming livestream",
        date: dateMatch?.[1],
        source: "Nugs",
        href,
        action: "Watch",
      });

      if (out.length >= 4) break;
    }

    return out;
  } catch {
    return [];
  }
}

async function fromJamBase(): Promise<LiveItem[]> {
  try {
    const html = await fetchText("https://www.jambase.com/concerts");
    const matches = Array.from(html.matchAll(/href=["']([^"']*\/show\/[^"']+)["']/gi));
    const out: LiveItem[] = [];
    const seen = new Set<string>();

    for (const match of matches) {
      const href = absolute(match[1], "https://www.jambase.com");
      if (seen.has(href)) continue;
      seen.add(href);

      const index = match.index ?? 0;
      const chunk = strip(html.slice(Math.max(0, index - 1000), index + 1200));

      const dateMatch = chunk.match(/\b(?:Jul|Aug|Sep|Oct|Nov|Dec|Jan|Feb|Mar|Apr|May|Jun)\s+\d{1,2}\b/i);
      const pieces = chunk.split(/ · |\|/).map((x) => x.trim()).filter((x) => x.length > 3 && x.length < 100);

      out.push({
        artist: pieces[0] || "Upcoming show",
        title: pieces[1] || "Concert details",
        date: dateMatch?.[0],
        source: "JamBase",
        href,
        action: "Details",
      });

      if (out.length >= 4) break;
    }

    return out;
  } catch {
    return [];
  }
}

export async function GET() {
  const [nugs, jambase] = await Promise.all([fromNugs(), fromJamBase()]);

  const combined = [...nugs, ...jambase].slice(0, 6);

  return NextResponse.json({
    updatedAt: new Intl.DateTimeFormat("en-US", {
      timeZone: "America/Chicago",
      hour: "numeric",
      minute: "2-digit",
    }).format(new Date()),
    items: combined,
  });
}
