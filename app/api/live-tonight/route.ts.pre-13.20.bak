import { NextResponse } from "next/server";

export const dynamic = "force-dynamic";

type LiveItem = {
  artist: string;
  venue?: string;
  location?: string;
  date?: string;
  time?: string;
  source: "Nugs" | "JamBase";
  href: string;
  action: "Watch" | "Details";
  sortTime: number;
};

