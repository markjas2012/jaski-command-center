.page {
  min-height: 100vh;
  padding: 44px;
  display: grid;
  place-items: start center;
}

.panel {
  width: min(820px, 100%);
  padding: 34px;
  border-radius: 26px;
  border: 1px solid rgba(20, 54, 86, 0.13);
  background: rgba(255, 255, 255, 0.58);
  box-shadow: 0 18px 55px rgba(31, 57, 82, 0.08);
}

.eyebrow {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.14em;
  opacity: 0.48;
}

.panel h1 {
  margin: 8px 0 6px;
  font-size: clamp(34px, 5vw, 58px);
  line-height: 1;
}

.lead {
  max-width: 650px;
  font-size: 16px;
  line-height: 1.6;
  opacity: 0.68;
}

.status {
  margin: 30px 0;
  padding: 18px;
  border-radius: 18px;
  border: 1px solid rgba(20, 54, 86, 0.12);
  display: flex;
  gap: 12px;
  align-items: flex-start;
}

.dot {
  width: 10px;
  height: 10px;
  margin-top: 5px;
  border-radius: 50%;
  border: 2px solid currentColor;
  opacity: 0.4;
}

.status strong {
  display: block;
  margin-bottom: 4px;
}

.status p {
  margin: 0;
  line-height: 1.5;
  opacity: 0.6;
}

.back {
  color: inherit;
  text-decoration: none;
  font-weight: 700;
  font-size: 13px;
}
