import Link from "next/link";
import styles from "./remote.module.css";

export default function RemotePage() {
  return (
    <main className={styles.page}>
      <section className={styles.panel}>
        <div className={styles.eyebrow}>JASKI COMMAND CENTER</div>
        <h1>Remote</h1>
        <p className={styles.lead}>
          Home control lives here. Device controls will appear only after the
          Command Center is connected to the home network.
        </p>

        <div className={styles.status}>
          <span className={styles.dot} aria-hidden="true" />
          <div>
            <strong>No home control connection</strong>
            <p>
              Nothing is simulated and no device state is guessed while this
              machine is away from the home network.
            </p>
          </div>
        </div>

        <Link href="/" className={styles.back}>← Back home</Link>
      </section>
    </main>
  );
}
