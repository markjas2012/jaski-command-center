.wrap{
  margin-top:14px;
  padding:28px;
  border:1px solid rgba(255,255,255,.16);
  border-radius:22px;
  background:linear-gradient(145deg,#1c1b21,#17171c);
  color:#fffaf3;
}
.heading{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:20px;
}
.heading p{
  margin:0 0 8px;
  color:#f0aeb8;
  font-size:9px;
  font-weight:900;
  letter-spacing:.18em;
}
.heading h2{
  margin:0;
  font-family:Georgia,serif;
  font-size:30px;
  font-weight:500;
  color:#fffdf8;
}
.heading small{
  display:block;
  margin-top:7px;
  color:#bbb5bc;
  font-size:10px;
}
.heading>span{
  color:#aaa3ab;
  font-size:9px;
}
.grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:10px;
  margin-top:18px;
}
.card{
  min-height:150px;
  display:flex;
  flex-direction:column;
  padding:18px;
  border:1px solid rgba(255,255,255,.14);
  border-radius:16px;
  background:linear-gradient(145deg,#242229,#1e1d23);
  color:#fffaf3;
  text-decoration:none;
}
.card:hover{
  border-color:rgba(240,174,184,.52);
  background:#29262d;
}
.meta{
  display:flex;
  justify-content:space-between;
  gap:12px;
}
.meta span{
  color:#f0aeb8;
  font-size:9px;
  font-weight:900;
  letter-spacing:.08em;
}
.meta small{
  color:#aaa3ab;
  font-size:9px;
}
.card h3{
  margin:15px 0 4px;
  font-family:Georgia,serif;
  font-size:18px;
  line-height:1.2;
  color:#fffdf8;
}
.card strong{
  color:#ddd6dc;
  font-size:11px;
  line-height:1.3;
}
.card p{
  margin:8px 0 0;
  color:#aaa3ab;
  font-size:9px;
  line-height:1.35;
}
.card b{
  margin-top:auto;
  padding-top:16px;
  color:#f3b7c0;
  font-size:9px;
}
@media(max-width:900px){
  .grid{grid-template-columns:1fr 1fr}
  .heading{align-items:flex-start;flex-direction:column}
}
@media(max-width:620px){
  .grid{grid-template-columns:1fr}
  .wrap{padding:20px}
}
