.wrap{
  margin-top:14px;
  padding:24px 26px;
  border:1px solid rgba(255,255,255,.16);
  border-radius:22px;
  background:
    radial-gradient(circle at 88% 26%,rgba(240,174,184,.16),transparent 27%),
    linear-gradient(145deg,#211f25,#19181d);
  color:#fffaf3;
}
.kickerRow{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
}
.kicker{
  color:#f0aeb8;
  font-size:9px;
  font-weight:900;
  letter-spacing:.18em;
}
.source{
  color:#f0aeb8;
  font-size:8px;
  font-weight:900;
  letter-spacing:.08em;
}
.body{
  display:grid;
  grid-template-columns:128px minmax(0,1fr) auto;
  gap:22px;
  align-items:start;
  margin-top:12px;
}
.artwork,.artworkFallback{
  width:128px;
  height:128px;
  border:1px solid rgba(255,255,255,.15);
  border-radius:16px;
  overflow:hidden;
  background:linear-gradient(145deg,#302a31,#211d23);
  box-shadow:0 10px 24px rgba(0,0,0,.15);
}
.artwork img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}
.artworkFallback{
  display:grid;
  place-items:center;
}
.artworkFallback span{
  font-family:Georgia,serif;
  font-size:54px;
  color:#f6c1c8;
}
.identity{min-width:0}
.artist{
  display:inline-flex;
  align-items:center;
  padding:5px 8px;
  border:1px solid rgba(255,255,255,.15);
  border-radius:999px;
  color:#f6c1c8;
  background:rgba(255,255,255,.04);
  font-size:8px;
  font-weight:900;
  letter-spacing:.1em;
  text-transform:uppercase;
}
.identity h2{
  margin:11px 0 0;
  font-family:Georgia,serif;
  font-size:31px;
  line-height:1.04;
  font-weight:500;
  color:#fffdf8;
}
.meta{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin-top:10px;
}
.meta span{
  padding-right:10px;
  border-right:1px solid rgba(255,255,255,.13);
  color:#c9c2c8;
  font-size:9px;
}
.meta span:last-child{border-right:0}
.why{
  margin-top:13px;
  max-width:860px;
}
.why strong,.highlights>strong{
  color:#f0aeb8;
  font-size:8px;
  font-weight:900;
  letter-spacing:.11em;
}
.why p{
  margin:5px 0 0;
  color:#bbb5bc;
  font-size:10px;
  line-height:1.45;
}
.highlights{
  margin-top:11px;
}
.highlights>div{
  display:flex;
  gap:7px;
  flex-wrap:wrap;
  margin-top:6px;
}
.highlights span{
  padding:5px 8px;
  border:1px solid rgba(255,255,255,.13);
  border-radius:999px;
  background:rgba(255,255,255,.035);
  color:#ddd6dc;
  font-size:8px;
}
.listen{
  display:inline-flex;
  margin-top:14px;
  padding:9px 13px;
  border:1px solid rgba(240,174,184,.34);
  border-radius:10px;
  background:rgba(240,174,184,.07);
  color:#f6c1c8;
  text-decoration:none;
  font-size:9px;
  font-weight:900;
}
.listen:hover{
  border-color:rgba(240,174,184,.55);
  background:rgba(240,174,184,.11);
}
.dateBadge{
  min-width:94px;
  display:flex;
  flex-direction:column;
  align-items:flex-end;
  gap:6px;
  color:#aaa3ab;
  font-size:8px;
}
.dateBadge span{
  color:#f0aeb8;
  font-weight:900;
  letter-spacing:.08em;
}
.dateBadge strong{
  color:#fffdf8;
  font-size:9px;
}
@media(max-width:900px){
  .body{grid-template-columns:110px minmax(0,1fr)}
  .dateBadge{display:none}
  .artwork,.artworkFallback{width:110px;height:110px}
}
@media(max-width:620px){
  .wrap{padding:20px}
  .body{grid-template-columns:1fr}
  .artwork,.artworkFallback{width:100%;height:160px}
  .identity h2{font-size:27px}
}
