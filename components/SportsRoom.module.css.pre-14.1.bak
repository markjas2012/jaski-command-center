.room{min-height:100%;padding:16px 16px 28px;color:#f7f4ee}.hero{position:relative;overflow:hidden;min-height:350px;padding:36px;border-radius:26px;background:radial-gradient(circle at 82% 20%,rgba(56,91,152,.30),transparent 28%),linear-gradient(135deg,#10151d 0%,#141a23 56%,#16233a 100%);border:1px solid rgba(255,255,255,.08);box-shadow:0 24px 54px rgba(20,30,45,.18)}.heroCopy{max-width:720px;padding-top:52px}.eyebrow,.cardKicker{margin:0;color:#8fb4ff;font-size:9px;font-weight:900;letter-spacing:.18em}.hero h1{margin:14px 0 12px;font-size:70px;line-height:.95;letter-spacing:-.045em}.lede{max-width:640px;margin:0;color:#b6bfca;font-size:16px;line-height:1.6}.badge{position:absolute;right:46px;top:54px;width:164px;height:164px;border:1px solid rgba(255,255,255,.10);border-radius:50%;display:grid;place-items:center;text-align:center;color:#8392a8;font-size:8px;font-weight:900;letter-spacing:.17em}.badge::after{content:"";position:absolute;inset:-12px;border:1px solid rgba(255,255,255,.035);border-radius:50%}.badgeLetter{display:block;font-family:Georgia,serif;font-size:52px;color:#fff;letter-spacing:0}.heroFooter{position:absolute;left:36px;right:36px;bottom:20px;display:flex;justify-content:space-between;gap:16px;padding-top:16px;border-top:1px solid rgba(255,255,255,.08);color:#718096;font-size:8px;font-weight:800;letter-spacing:.12em}.grid{display:grid;grid-template-columns:1.25fr .75fr;gap:14px;margin-top:14px}.primaryCard,.strip,.sideCard{border:1px solid rgba(255,255,255,.07);border-radius:22px;background:#11161e}.primaryCard{padding:28px}.primaryCard h2,.strip h2{margin:8px 0 12px;font-family:Georgia,serif;font-size:34px;font-weight:500}.primaryCard>p:not(.cardKicker),.strip>p{color:#a8b0ba;line-height:1.55}.linkGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:24px}.linkGrid a{display:flex;align-items:center;gap:12px;min-height:76px;padding:14px;border:1px solid rgba(255,255,255,.07);border-radius:16px;background:linear-gradient(145deg,#171d27,#11161e);color:#fff;text-decoration:none}.linkGrid a:hover{border-color:rgba(143,180,255,.30);transform:translateY(-1px)}.linkMark{display:grid;place-items:center;width:34px;height:34px;border-radius:11px;background:#1d2b42;color:#a8c4ff;font-weight:900}.linkGrid strong,.linkGrid small{display:block}.linkGrid small{margin-top:3px;color:#7f8995;font-size:9px}.linkGrid b{margin-left:auto;color:#91aff0}.sideGrid{display:grid;gap:14px}.sideCard{display:flex;flex-direction:column;justify-content:space-between;min-height:188px;padding:24px;text-decoration:none;color:#f6f4ef;background:linear-gradient(145deg,#151a22,#121821)}.sideCard h3{margin:16px 0 8px;font-family:Georgia,serif;font-size:26px}.sideCard p{margin:0;color:#9fa8b4;line-height:1.5}.sideCard strong{margin-top:24px;color:#a9c2ff;font-size:10px}.strip{display:grid;grid-template-columns:.9fr 1.1fr;gap:24px;margin-top:14px;padding:26px 28px;background:linear-gradient(135deg,#151a22,#121b29)}@media(max-width:1000px){.grid{grid-template-columns:1fr}.badge{opacity:.28}.strip{grid-template-columns:1fr}}@media(max-width:650px){.hero{padding:24px}.heroCopy{padding-top:24px}.hero h1{font-size:52px}.badge{display:none}.heroFooter{left:24px;right:24px}.linkGrid{grid-template-columns:1fr}}