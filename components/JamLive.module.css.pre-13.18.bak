.wrap{
  margin-top:14px;padding:28px;border:1px solid rgba(255,255,255,.16);
  border-radius:22px;background:linear-gradient(145deg,#1c1b21,#17171c);color:#fffaf3;
  box-shadow:0 12px 30px rgba(0,0,0,.12)
}
.heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:18px}
.heading p{margin:0 0 8px;color:#f0aeb8;font-size:9px;font-weight:900;letter-spacing:.18em}
.heading h2{margin:0;font-family:Georgia,serif;font-size:30px;font-weight:500;color:#fffdf8}
.heading small{display:block;margin-top:7px;color:#bbb5bc;font-size:10px}
.heading>span{color:#aaa3ab;font-size:9px}
.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.story{
  min-height:150px;padding:18px;border:1px solid rgba(255,255,255,.14);border-radius:16px;
  background:linear-gradient(145deg,#242229,#1e1d23);color:#fffaf3;text-decoration:none;
  display:flex;flex-direction:column;transition:.15s ease
}
.story:hover{border-color:rgba(240,174,184,.52);background:#29262d;transform:translateY(-1px)}
.storyTop{display:flex;justify-content:space-between;gap:12px;align-items:center}
.source{color:#f0aeb8;font-size:9px;font-weight:900;letter-spacing:.1em}
.storyTop small{color:#aaa3ab;font-size:9px}
.story h3{margin:16px 0 18px;font-family:Georgia,serif;font-size:17px;line-height:1.28;color:#fffdf8}
.story b{margin-top:auto;color:#f3b7c0;font-size:9px}
@media(max-width:900px){.grid{grid-template-columns:1fr 1fr}.heading{align-items:flex-start;flex-direction:column}}
@media(max-width:620px){.grid{grid-template-columns:1fr}.wrap{padding:20px}}
